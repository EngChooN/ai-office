{
  "name": "claude-office",
  "productName": "AI Office",
  "version": "0.16.3",
  "private": true,
  "description": "AI 직원을 고용해 일을 맡기는 사무실 앱",
  "license": "MIT",
  "author": {
    "name": "joonyoungcho",
    "email": "joonyoung.cho@flitto.com"
  },
  "main": ".vite/build/index.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:win": "electron-forge make --platform win32 --arch x64",
    "typecheck": "tsc --noEmit",
    "build:mobile": "vite build -c vite.mobile.config.mts",
    "build:mobile:preview": "vite build -c vite.mobile.config.mts --mode preview",
    "preview:mobile": "vite build -c vite.mobile.config.mts --mode preview && vite preview -c vite.mobile.config.mts --mode preview --port 5299 --strictPort",
    "preview:iso": "vite build -c vite.iso.config.mts && vite preview -c vite.iso.config.mts --port 5301 --strictPort",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/*.test.mts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.304",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gifenc": "1.0.3",
    "lucide-react": "^1.60.0",
    "phaser": "^4.2.1",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "remark-cjk-friendly": "1.2.3",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
